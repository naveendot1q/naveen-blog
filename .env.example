# Supabase Configuration
# Replace with your Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Admin email — only this email can log in and post blogs
NEXT_PUBLIC_ADMIN_EMAIL=naveenmeel10@gmail.com

# ── GitHub blog sync ──────────────────────────────────────────
# Server-only — never prefix these with NEXT_PUBLIC_, they'd end up
# in the browser bundle.

# Fine-grained PAT scoped to just the content repo, with
# Contents: Read and write permission (needed for both directions —
# pulling posts in, and pushing admin-panel edits back out).
GITHUB_TOKEN=github_pat_...

# owner/repo of the content repo
GITHUB_REPO=naveendot1q/Naaveen

# Supabase → Project Settings → API → service_role key.
# Bypasses RLS — only ever used server-side in app/api/* routes.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Random string you generate yourself (e.g. `openssl rand -hex 32`).
# Authenticates calls to /api/sync-github — set the same value here
# and wherever you configure the hourly trigger.
CRON_SECRET=YOUR_RANDOM_SECRET

